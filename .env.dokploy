# Paste into the Environment tab of the Dokploy compose app and fill in the … values.
# Dokploy writes it to .env next to compose.yml, which loads it into every app service.

# Version of ghcr.io/reinerttomas/matchday that every app service runs. Managed by the release
# and deploy workflows, which set it on every deploy; `latest` only matters for a deploy started in Dokploy before the first workflow deploy.
IMAGE_TAG=latest

APP_NAME=Matchday
APP_ENV=production
# php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://…

APP_LOCALE=cs
APP_FALLBACK_LOCALE=en

# serversideup/php image. Traefik terminates TLS, so Octane serves plain HTTP.
PHP_OPCACHE_ENABLE=1
SSL_MODE=off

DB_BUSY_TIMEOUT=5000

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

LOG_CHANNEL=stack
LOG_STACK=stderr,nightwatch
LOG_LEVEL=info
NIGHTWATCH_LOG_LEVEL=warning

MAIL_MAILER=resend
RESEND_API_KEY=…
MAIL_FROM_ADDRESS=…
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=…
GOOGLE_CLIENT_SECRET=…
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

NIGHTWATCH_ENABLED=true
NIGHTWATCH_TOKEN=…
NIGHTWATCH_CAPTURE_REQUEST_PAYLOAD=true
# Every field that carries a secret: passwords, 2FA codes, the password reset token and the passkey assertion.
NIGHTWATCH_REDACT_PAYLOAD_FIELDS=_token,password,password_confirmation,current_password,code,recovery_code,token,credential
