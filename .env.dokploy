# Paste into the Environment tab of the Dokploy compose app and fill in the … values.
# Dokploy writes it to .env next to compose.yml, which loads it into every app service.

APP_NAME=Matchday
APP_ENV=production
# php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://…

APP_LOCALE=cs
APP_FALLBACK_LOCALE=en

# serversideup/php image. Traefik terminates TLS, so Octane serves plain HTTP.
PHP_OPCACHE_ENABLE=1
SSL_MODE=off

DB_BUSY_TIMEOUT=5000

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

LOG_CHANNEL=stack
LOG_STACK=stderr,nightwatch
LOG_LEVEL=info
NIGHTWATCH_LOG_LEVEL=warning

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=…
MAIL_PORT=587
MAIL_USERNAME=…
MAIL_PASSWORD=…
MAIL_FROM_ADDRESS=…
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=…
GOOGLE_CLIENT_SECRET=…
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

NIGHTWATCH_ENABLED=true
NIGHTWATCH_TOKEN=…
